<Page
    x:Class="NovaUWP.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource WindowAcrylicBrush}">

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="32" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- 自绘标题栏：视图延伸到标题栏，系统只画右上角三个按钮 -->
    <Grid x:Name="AppTitleBar" Background="Transparent">
      <StackPanel Orientation="Horizontal" Spacing="12" Margin="16,0,0,0" VerticalAlignment="Center">
        <Border Width="20" Height="20" CornerRadius="5" Background="{ThemeResource SystemControlBackgroundAccentBrush}">
          <FontIcon Glyph="&#xE9E9;" FontSize="12" Foreground="White" />
        </Border>
        <TextBlock Text="Nova 设置" FontSize="12" VerticalAlignment="Center" />
        <TextBlock Text="UWP" FontSize="12" VerticalAlignment="Center" Foreground="{StaticResource TertiaryTextBrush}" />
      </StackPanel>
    </Grid>

    <!-- 系统自带的 NavigationView（Windows 10 Fluent，左侧窄栏 + 亚克力窗格） -->
    <NavigationView x:Name="Nav" Grid.Row="1"
                    PaneDisplayMode="LeftCompact"
                    IsBackButtonVisible="Collapsed"
                    IsPaneToggleButtonVisible="False"
                    IsSettingsVisible="True"
                    AlwaysShowHeader="False">
      <NavigationView.MenuItems>
        <NavigationViewItem Content="常规" ToolTipService.ToolTip="常规">
          <NavigationViewItem.Icon><FontIcon Glyph="&#xE9E9;" /></NavigationViewItem.Icon>
        </NavigationViewItem>
        <NavigationViewItem Content="画面" ToolTipService.ToolTip="画面">
          <NavigationViewItem.Icon><FontIcon Glyph="&#xE7F4;" /></NavigationViewItem.Icon>
        </NavigationViewItem>
        <NavigationViewItem Content="音频" ToolTipService.ToolTip="音频">
          <NavigationViewItem.Icon><FontIcon Glyph="&#xE767;" /></NavigationViewItem.Icon>
        </NavigationViewItem>
        <NavigationViewItem Content="网络" ToolTipService.ToolTip="网络">
          <NavigationViewItem.Icon><FontIcon Glyph="&#xE774;" /></NavigationViewItem.Icon>
        </NavigationViewItem>
        <NavigationViewItem Content="快捷键" ToolTipService.ToolTip="快捷键">
          <NavigationViewItem.Icon><FontIcon Glyph="&#xE765;" /></NavigationViewItem.Icon>
        </NavigationViewItem>
        <NavigationViewItem Content="列表" ToolTipService.ToolTip="列表">
          <NavigationViewItem.Icon><FontIcon Glyph="&#xE8FD;" /></NavigationViewItem.Icon>
        </NavigationViewItem>
        <NavigationViewItem Content="文件夹" ToolTipService.ToolTip="文件夹">
          <NavigationViewItem.Icon><FontIcon Glyph="&#xE8B7;" /></NavigationViewItem.Icon>
        </NavigationViewItem>
      </NavigationView.MenuItems>

      <NavigationView.PaneFooter>
        <PersonPicture DisplayName="Nova" Width="28" Height="28" Margin="10,0,0,6" HorizontalAlignment="Left" />
      </NavigationView.PaneFooter>

      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Padding="20,0,20,16">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>

          <!-- 顶部标签：UWP 的 Pivot，标题带图标；内容放在下面，切换标签不换内容 -->
          <Pivot x:Name="Tabs" Margin="-12,0,0,6">
            <PivotItem AutomationProperties.Name="常规">
              <PivotItem.Header>
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <FontIcon Glyph="&#xE9E9;" FontSize="16" />
                  <TextBlock Text="常规" FontSize="15" VerticalAlignment="Center" />
                </StackPanel>
              </PivotItem.Header>
            </PivotItem>
            <PivotItem AutomationProperties.Name="画面">
              <PivotItem.Header>
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <FontIcon Glyph="&#xE7F4;" FontSize="16" />
                  <TextBlock Text="画面" FontSize="15" VerticalAlignment="Center" />
                </StackPanel>
              </PivotItem.Header>
            </PivotItem>
            <PivotItem AutomationProperties.Name="音频">
              <PivotItem.Header>
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <FontIcon Glyph="&#xE767;" FontSize="16" />
                  <TextBlock Text="音频" FontSize="15" VerticalAlignment="Center" />
                </StackPanel>
              </PivotItem.Header>
            </PivotItem>
            <PivotItem AutomationProperties.Name="网络">
              <PivotItem.Header>
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <FontIcon Glyph="&#xE774;" FontSize="16" />
                  <TextBlock Text="网络" FontSize="15" VerticalAlignment="Center" />
                </StackPanel>
              </PivotItem.Header>
            </PivotItem>
            <PivotItem AutomationProperties.Name="快捷键">
              <PivotItem.Header>
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <FontIcon Glyph="&#xE765;" FontSize="16" />
                  <TextBlock Text="快捷键" FontSize="15" VerticalAlignment="Center" />
                </StackPanel>
              </PivotItem.Header>
            </PivotItem>
          </Pivot>

          <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition />
              <ColumnDefinition />
            </Grid.ColumnDefinitions>

            <!-- 左：常规选项 -->
            <Border Style="{StaticResource CardStyle}" VerticalAlignment="Top">
              <StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,2,0,6">
                  <FontIcon Glyph="&#xE9E9;" FontSize="16" Foreground="{ThemeResource SystemControlForegroundAccentBrush}" />
                  <TextBlock Text="常规选项" Style="{StaticResource CardTitleStyle}" />
                </StackPanel>
                <StackPanel x:Name="GeneralRows" />
              </StackPanel>
            </Border>

            <StackPanel Grid.Column="1" Spacing="12">
              <!-- 右上：性能 -->
              <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,2,0,6">
                    <FontIcon Glyph="&#xEC4A;" FontSize="16" Foreground="{ThemeResource SystemControlForegroundAccentBrush}" />
                    <TextBlock Text="性能" Style="{StaticResource CardTitleStyle}" />
                  </StackPanel>
                  <StackPanel x:Name="PerfRows" />
                </StackPanel>
              </Border>

              <!-- 右下：显示 -->
              <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,2,0,6">
                    <FontIcon Glyph="&#xE706;" FontSize="16" Foreground="{ThemeResource SystemControlForegroundAccentBrush}" />
                    <TextBlock Text="显示" Style="{StaticResource CardTitleStyle}" />
                  </StackPanel>
                  <StackPanel x:Name="DisplayRows" />
                  <Rectangle Height="1" Margin="0,6,4,8" Fill="{StaticResource DividerBrush}" />
                  <Grid Margin="0,0,4,0">
                    <TextBlock Text="亮度" />
                    <TextBlock x:Name="BrightText" Text="80%" HorizontalAlignment="Right" />
                  </Grid>
                  <Slider x:Name="Bright" Minimum="0" Maximum="100" Value="80"
                          AutomationProperties.Name="亮度" Margin="0,0,4,4" />
                  <Grid Margin="0,0,4,0">
                    <TextBlock Text="对比度" />
                    <TextBlock x:Name="ContrastText" Text="35%" HorizontalAlignment="Right" />
                  </Grid>
                  <Slider x:Name="Contrast" Minimum="0" Maximum="100" Value="35"
                          AutomationProperties.Name="对比度" Margin="0,0,4,0" />
                </StackPanel>
              </Border>
            </StackPanel>
          </Grid>
        </Grid>
      </ScrollViewer>
    </NavigationView>
  </Grid>
</Page>
