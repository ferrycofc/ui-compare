<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="NovaMaui.MainPage"
             BackgroundColor="{StaticResource PageBg}">

  <Grid ColumnDefinitions="56,*">

    <!-- 左侧竖排图标栏（代码里生成 7 个图标），底部是头像和设置 -->
    <Grid RowDefinitions="*,Auto" Padding="0,4,0,8">
      <VerticalStackLayout x:Name="Rail" Spacing="4" HorizontalOptions="Center" />

      <VerticalStackLayout Grid.Row="1" Spacing="6" HorizontalOptions="Center">
        <Border WidthRequest="28" HeightRequest="28" StrokeThickness="0"
                StrokeShape="RoundRectangle 14" BackgroundColor="#5C5C5C"
                HorizontalOptions="Center">
          <Label Text="N" FontSize="12" FontAttributes="Bold"
                 HorizontalOptions="Center" VerticalOptions="Center" />
        </Border>
        <Button Text="&#xE713;" FontFamily="Segoe Fluent Icons" FontSize="16"
                TextColor="{StaticResource TextPrimary}" BackgroundColor="Transparent"
                BorderWidth="0" Padding="0" CornerRadius="4"
                WidthRequest="40" HeightRequest="36"
                SemanticProperties.Description="设置" />
      </VerticalStackLayout>
    </Grid>

    <!-- 右侧内容 -->
    <ScrollView Grid.Column="1">
      <Grid RowDefinitions="Auto,*" RowSpacing="10" Padding="8,0,20,16">

        <!-- 顶部带图标的标签（代码里生成），选中项下面有强调色横条 -->
        <HorizontalStackLayout x:Name="Tabs" Spacing="4" />

        <Grid Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="12">

          <!-- 左：常规选项 -->
          <Border VerticalOptions="Start" StrokeShape="RoundRectangle 8" StrokeThickness="1"
                  Stroke="{StaticResource CardStroke}" BackgroundColor="{StaticResource CardBg}"
                  Padding="16,12,12,12">
            <VerticalStackLayout>
              <HorizontalStackLayout Spacing="10" Margin="0,2,0,6">
                <Label Style="{StaticResource Icon}" Text="&#xE9E9;" TextColor="{StaticResource Accent}" />
                <Label Style="{StaticResource CardTitle}" Text="常规选项" />
              </HorizontalStackLayout>
              <VerticalStackLayout x:Name="GeneralRows" />
            </VerticalStackLayout>
          </Border>

          <VerticalStackLayout Grid.Column="1" Spacing="12">
            <!-- 右上：性能 -->
            <Border StrokeShape="RoundRectangle 8" StrokeThickness="1"
                    Stroke="{StaticResource CardStroke}" BackgroundColor="{StaticResource CardBg}"
                    Padding="16,12,12,12">
              <VerticalStackLayout>
                <HorizontalStackLayout Spacing="10" Margin="0,2,0,6">
                  <Label Style="{StaticResource Icon}" Text="&#xEC4A;" TextColor="{StaticResource Accent}" />
                  <Label Style="{StaticResource CardTitle}" Text="性能" />
                </HorizontalStackLayout>
                <VerticalStackLayout x:Name="PerfRows" />
              </VerticalStackLayout>
            </Border>

            <!-- 右下：显示 -->
            <Border StrokeShape="RoundRectangle 8" StrokeThickness="1"
                    Stroke="{StaticResource CardStroke}" BackgroundColor="{StaticResource CardBg}"
                    Padding="16,12,12,12">
              <VerticalStackLayout>
                <HorizontalStackLayout Spacing="10" Margin="0,2,0,6">
                  <Label Style="{StaticResource Icon}" Text="&#xE706;" TextColor="{StaticResource Accent}" />
                  <Label Style="{StaticResource CardTitle}" Text="显示" />
                </HorizontalStackLayout>
                <VerticalStackLayout x:Name="DisplayRows" />

                <BoxView HeightRequest="1" Color="#3A3A3A" Margin="0,6,4,8" />

                <Grid ColumnDefinitions="*,Auto" Margin="0,0,4,0">
                  <Label Text="亮度" />
                  <Label x:Name="BrightText" Grid.Column="1" Text="80%" />
                </Grid>
                <Slider x:Name="Bright" Minimum="0" Maximum="100" Value="80"
                        MinimumTrackColor="{StaticResource Accent}" ThumbColor="{StaticResource Accent}"
                        SemanticProperties.Description="亮度" Margin="0,0,4,4" />

                <Grid ColumnDefinitions="*,Auto" Margin="0,0,4,0">
                  <Label Text="对比度" />
                  <Label x:Name="ContrastText" Grid.Column="1" Text="35%" />
                </Grid>
                <Slider x:Name="Contrast" Minimum="0" Maximum="100" Value="35"
                        MinimumTrackColor="{StaticResource Accent}" ThumbColor="{StaticResource Accent}"
                        SemanticProperties.Description="对比度" Margin="0,0,4,0" />
              </VerticalStackLayout>
            </Border>
          </VerticalStackLayout>
        </Grid>
      </Grid>
    </ScrollView>
  </Grid>
</ContentPage>
