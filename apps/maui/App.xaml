<?xml version="1.0" encoding="UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="NovaMaui.App">
  <Application.Resources>
    <ResourceDictionary>
      <!-- 颜色都写死成深色，和其它版本一致 -->
      <Color x:Key="Accent">#60CDFF</Color>
      <Color x:Key="PageBg">#202020</Color>
      <Color x:Key="CardBg">#2B2B2B</Color>
      <Color x:Key="CardStroke">#1C1C1C</Color>
      <Color x:Key="Subtle">#383838</Color>
      <Color x:Key="TextPrimary">#FFFFFF</Color>
      <Color x:Key="TextSecondary">#C5C5C5</Color>
      <Color x:Key="TextTertiary">#878787</Color>

      <Style TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
        <Setter Property="FontSize" Value="14" />
      </Style>

      <!-- 字体图标：Windows 11 自带的 Segoe Fluent Icons -->
      <Style x:Key="Icon" TargetType="Label">
        <Setter Property="FontFamily" Value="Segoe Fluent Icons" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="HorizontalOptions" Value="Center" />
      </Style>

      <Style x:Key="CardTitle" TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="VerticalOptions" Value="Center" />
      </Style>
    </ResourceDictionary>
  </Application.Resources>
</Application>
