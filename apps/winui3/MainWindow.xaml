<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="NovaWinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Nova 设置 — WinUI 3">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 自绘标题栏（内容延伸到标题栏，系统只画右上角三个按钮） -->
        <Grid x:Name="AppTitleBar" Background="Transparent">
            <StackPanel Orientation="Horizontal" Spacing="12" Margin="16,0,0,0" VerticalAlignment="Center">
                <Border Width="20" Height="20" CornerRadius="5" Background="{ThemeResource AccentFillColorDefaultBrush}">
                    <FontIcon Glyph="&#xE9E9;" FontSize="12" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                </Border>
                <TextBlock Text="Nova 设置" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
                <TextBlock Text="WinUI 3" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
            </StackPanel>
        </Grid>

        <NavigationView x:Name="Nav" Grid.Row="1"
                        PaneDisplayMode="LeftCompact"
                        IsBackButtonVisible="Collapsed"
                        IsPaneToggleButtonVisible="False"
                        IsSettingsVisible="True">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="常规" ToolTipService.ToolTip="常规">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE9E9;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="画面" ToolTipService.ToolTip="画面">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE7F4;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="音频" ToolTipService.ToolTip="音频">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE767;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="网络" ToolTipService.ToolTip="网络">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE774;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="快捷键" ToolTipService.ToolTip="快捷键">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE765;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="列表" ToolTipService.ToolTip="列表">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE8FD;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="文件夹" ToolTipService.ToolTip="文件夹">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE8B7;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <NavigationView.PaneFooter>
                <PersonPicture DisplayName="Nova" Width="28" Height="28" Margin="10,0,0,6" HorizontalAlignment="Left" />
            </NavigationView.PaneFooter>

            <ScrollViewer>
                <Grid Padding="20,4,20,16" RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- 顶部标签 -->
                    <SelectorBar>
                        <SelectorBarItem Text="常规" IsSelected="True">
                            <SelectorBarItem.Icon><FontIcon Glyph="&#xE9E9;" /></SelectorBarItem.Icon>
                        </SelectorBarItem>
                        <SelectorBarItem Text="画面">
                            <SelectorBarItem.Icon><FontIcon Glyph="&#xE7F4;" /></SelectorBarItem.Icon>
                        </SelectorBarItem>
                        <SelectorBarItem Text="音频">
                            <SelectorBarItem.Icon><FontIcon Glyph="&#xE767;" /></SelectorBarItem.Icon>
                        </SelectorBarItem>
                        <SelectorBarItem Text="网络">
                            <SelectorBarItem.Icon><FontIcon Glyph="&#xE774;" /></SelectorBarItem.Icon>
                        </SelectorBarItem>
                        <SelectorBarItem Text="快捷键">
                            <SelectorBarItem.Icon><FontIcon Glyph="&#xE765;" /></SelectorBarItem.Icon>
                        </SelectorBarItem>
                    </SelectorBar>

                    <Grid Grid.Row="1" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>

                        <!-- 左：常规选项 -->
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,2,0,6">
                                    <FontIcon Glyph="&#xE9E9;" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                    <TextBlock Text="常规选项" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                </StackPanel>
                                <StackPanel x:Name="GeneralRows" />
                            </StackPanel>
                        </Border>

                        <StackPanel Grid.Column="1" Spacing="12">
                            <!-- 右上：性能 -->
                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,2,0,6">
                                        <FontIcon Glyph="&#xEC4A;" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                        <TextBlock Text="性能" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    </StackPanel>
                                    <StackPanel x:Name="PerfRows" />
                                </StackPanel>
                            </Border>

                            <!-- 右下：显示 -->
                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,2,0,6">
                                        <FontIcon Glyph="&#xE706;" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                        <TextBlock Text="显示" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    </StackPanel>
                                    <StackPanel x:Name="DisplayRows" />
                                    <Rectangle Height="1" Margin="0,6,4,8" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                                    <Grid Margin="0,0,4,0">
                                        <TextBlock Text="亮度" />
                                        <TextBlock x:Name="BrightText" Text="80%" HorizontalAlignment="Right" />
                                    </Grid>
                                    <Slider x:Name="Bright" AutomationProperties.Name="亮度" Minimum="0" Maximum="100" Value="80" Margin="0,0,4,4" />
                                    <Grid Margin="0,0,4,0">
                                        <TextBlock Text="对比度" />
                                        <TextBlock x:Name="ContrastText" Text="35%" HorizontalAlignment="Right" />
                                    </Grid>
                                    <Slider x:Name="Contrast" AutomationProperties.Name="对比度" Minimum="0" Maximum="100" Value="35" Margin="0,0,4,0" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Grid>
            </ScrollViewer>
        </NavigationView>
    </Grid>
</Window>
