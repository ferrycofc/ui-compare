{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nova",
  "version": "1.0.0",
  "identifier": "com.nova.settings",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Nova 设置 — Tauri",
        "width": 904,
        "height": 621,
        "resizable": false,
        "maximizable": false,
        "center": true,
        "theme": "Dark",
        "backgroundColor": "#0f1014"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
